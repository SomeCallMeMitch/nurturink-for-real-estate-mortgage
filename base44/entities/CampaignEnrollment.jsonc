{
  "name": "CampaignEnrollment",
  "type": "object",
  "description": "Tracks which clients are enrolled in which campaigns",
  "properties": {
    "campaignId": {
      "type": "string",
      "description": "Campaign the client is enrolled in"
    },
    "clientId": {
      "type": "string",
      "description": "Enrolled client ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "enrolled",
        "excluded",
        "completed",
        "paused"
      ],
      "default": "enrolled",
      "description": "Enrollment status"
    },
    "enrolledAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the client was enrolled"
    },
    "excludedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When excluded (if status=excluded)"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When sequence completed (if status=completed)"
    },
    "lastSentDate": {
      "type": "string",
      "format": "date",
      "nullable": true,
      "description": "Last date a card was sent for this enrollment"
    },
    "lastSentStep": {
      "type": "integer",
      "nullable": true,
      "description": "Last step number that was sent"
    },
    "processedWelcome": {
      "type": "boolean",
      "default": false,
      "nullable": true,
      "description": "Whether a welcome send has been scheduled for this enrollment. Prevents duplicate welcome sends."
    }
  },
  "required": [
    "campaignId",
    "clientId",
    "enrolledAt"
  ]
}