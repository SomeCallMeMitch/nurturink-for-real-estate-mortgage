{
  "name": "Campaign",
  "type": "object",
  "description": "User-created campaign configuration using the System B campaign architecture",
  "properties": {
    "orgId": {
      "type": "string",
      "description": "Organization that owns this campaign"
    },
    "ownerId": {
      "type": "string",
      "description": "User ID of the rep who owns this campaign"
    },
    "createdBy": {
      "type": "string",
      "description": "User ID who created this campaign"
    },
    "name": {
      "type": "string",
      "description": "User-friendly campaign name"
    },
    "type": {
      "type": "string",
      "description": "CampaignType slug"
    },
    "triggerTypeId": {
      "type": "string",
      "nullable": true,
      "description": "CampaignType record ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "draft"
      ],
      "default": "draft",
      "description": "Current campaign status"
    },
    "enrollmentMode": {
      "type": "string",
      "enum": [
        "opt_in",
        "opt_out"
      ],
      "default": "opt_out",
      "description": "How recipients are enrolled"
    },
    "triggerField": {
      "type": "string",
      "nullable": true,
      "description": "Client date field that triggers this campaign. Nullable for manual campaign drafts until manual scheduling is implemented."
    },
    "dateField": {
      "type": "string",
      "nullable": true,
      "description": "Legacy compatibility mirror of triggerField"
    },
    "requiresApproval": {
      "type": "boolean",
      "default": false,
      "description": "Whether scheduled sends require approval"
    },
    "returnAddressMode": {
      "type": "string",
      "enum": [
        "company",
        "rep",
        "none"
      ],
      "default": "company",
      "description": "Return address mode for sends generated by this campaign"
    },
    "description": {
      "type": "string",
      "nullable": true,
      "description": "Optional campaign description"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the campaign was created"
    }
  },
  "required": [
    "orgId",
    "ownerId",
    "createdBy",
    "name",
    "type",
    "enrollmentMode"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.orgId": "{{user.orgId}}"
    },
    "update": {
      "data.orgId": "{{user.orgId}}"
    },
    "delete": {
      "data.orgId": "{{user.orgId}}"
    }
  }
}
