{
  "name": "Campaign",
  "type": "object",
  "description": "Automated card sending campaign configuration",
  "properties": {
    "orgId": {
      "type": "string",
      "description": "Organization that owns this campaign"
    },
    "ownerId": {
      "type": "string",
      "description": "The User ID of the rep who owns this campaign. Allows for ownership transfers."
    },
    "createdBy": {
      "type": "string",
      "description": "User ID who created this campaign (immutable)"
    },
    "name": {
      "type": "string",
      "description": "User-friendly campaign name (e.g., 'Birthday Wishes')"
    },
    "type": {
      "type": "string",
      "description": "Campaign type slug (e.g., 'birthday', 'welcome', 'renewal'). Driven by CampaignType entity."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "draft"
      ],
      "default": "draft",
      "description": "Campaign status"
    },
    "enrollmentMode": {
      "type": "string",
      "enum": [
        "opt_in",
        "opt_out"
      ],
      "description": "How recipients are enrolled - opt_out means all eligible clients are auto-enrolled"
    },
    "triggerField": {
      "type": "string",
      "nullable": true,
      "description": "Client date field that triggers this campaign. Nullable for draft manual campaigns until manual scheduling is implemented."
    },
    "requiresApproval": {
      "type": "boolean",
      "default": false,
      "description": "If true, sends go to approval queue before sending"
    },
    "returnAddressMode": {
      "type": "string",
      "enum": [
        "company",
        "rep",
        "none"
      ],
      "default": "company",
      "description": "Return address mode for cards sent by this campaign"
    },
    "description": {
      "type": "string",
      "nullable": true,
      "description": "Optional description of the campaign"
    },
    "scheduleMode": {
      "type": "string",
      "enum": [
        "client_date",
        "calendar"
      ],
      "nullable": true,
      "description": "Determines whether scheduling uses client trigger dates or calendar-based campaign dates."
    },
    "scheduleFrequency": {
      "type": "string",
      "enum": [
        "quarterly"
      ],
      "nullable": true,
      "description": "Calendar campaign frequency."
    },
    "scheduleMonths": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "nullable": true,
      "description": "Array of 1-based calendar month numbers, for example [1, 4, 7, 10] for Jan/Apr/Jul/Oct."
    },
    "scheduleDayOfMonth": {
      "type": "number",
      "nullable": true,
      "description": "Day of the month to generate scheduled sends."
    },
    "nextRunDate": {
      "type": "string",
      "format": "date",
      "nullable": true,
      "description": "Next date this calendar campaign should generate sends, stored as YYYY-MM-DD."
    },
    "lastRunDate": {
      "type": "string",
      "format": "date",
      "nullable": true,
      "description": "Last date this calendar campaign generated sends, stored as YYYY-MM-DD."
    }
  },
  "required": [
    "orgId",
    "ownerId",
    "createdBy",
    "name",
    "type",
    "enrollmentMode"
  ]
}