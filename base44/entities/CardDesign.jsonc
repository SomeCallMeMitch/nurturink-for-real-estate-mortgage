{
  "name": "CardDesign",
  "type": "object",
  "description": "Available card designs for automated card sends",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the card design (e.g., 'Thank you - Plain White')"
    },
    "key": {
      "type": "string",
      "description": "Unique identifier for the card design (e.g., 'thank_you_plain_white')"
    },
    "description": {
      "type": "string",
      "description": "Description of the card design"
    },
    "category": {
      "type": "string",
      "description": "Category of card design (e.g., 'Thank You', 'Birthday', 'Congratulations')"
    },
    "imageUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL to preview image of the card design"
    },
    "isActive": {
      "type": "boolean",
      "description": "Whether this card design is available for use",
      "default": true
    },
    "isDefault": {
      "type": "boolean",
      "description": "Whether this is a default card design provided by Scribe",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "description": "Display order in UI",
      "default": 0
    },
    "type": {
      "type": "string",
      "description": "Card design scope/type, such as platform or organization-specific",
      "default": "platform"
    },
    "orgId": {
      "type": "string",
      "description": "Organization ID for organization-specific card designs",
      "nullable": true
    },
    "industry": {
      "type": "string",
      "description": "Industry this card design is intended for",
      "nullable": true
    },
    "insideImageUrl": {
      "type": "string",
      "description": "Digital preview image URL for the inside of the card",
      "nullable": true
    },
    "outsideImageUrl": {
      "type": "string",
      "description": "Digital preview image URL for the outside of the card",
      "nullable": true
    },
    "frontImageUrl": {
      "type": "string",
      "description": "Physical card front image URL",
      "nullable": true
    },
    "backImageUrl": {
      "type": "string",
      "description": "Physical card back image URL",
      "nullable": true
    },
    "printReadyFrontUrl": {
      "type": "string",
      "description": "Print-ready outside/cover file URL or private file URI",
      "nullable": true
    },
    "printReadyBackUrl": {
      "type": "string",
      "description": "Print-ready inside/interior file URL or private file URI",
      "nullable": true
    },
    "scribeZipUrl": {
      "type": "string",
      "description": "Private file URI for the generated Scribe ZIP package",
      "nullable": true
    },
    "scribeDesignId": {
      "type": "string",
      "description": "External Scribe design identifier",
      "nullable": true
    },
    "outsideImageVariants": {
      "type": "object",
      "description": "Generated/resized outside image variants for display contexts",
      "nullable": true,
      "properties": {
        "w600": {
          "type": "string"
        },
        "w400": {
          "type": "string"
        },
        "w200": {
          "type": "string"
        }
      }
    },
    "cardDesignCategoryIds": {
      "type": "array",
      "description": "Card design category IDs assigned to this design",
      "nullable": true,
      "items": {
        "type": "string"
      }
    },
    "usageCount": {
      "type": "number",
      "description": "Number of times this design has been used",
      "default": 0
    }
  },
  "required": []
}