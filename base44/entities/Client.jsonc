{
  "name": "Client",
  "type": "object",
  "description": "Client/contact information for automation targeting",
  "properties": {
    "fullName": {
      "type": "string",
      "description": "Full name of the client"
    },
    "firstName": {
      "type": "string",
      "description": "Client's first name"
    },
    "lastName": {
      "type": "string",
      "description": "Client's last name"
    },
    "street": {
      "type": "string",
      "description": "Street address for card mailing"
    },
    "address2": {
      "type": "string",
      "description": "Apartment, suite, unit, or secondary address line"
    },
    "zipCode": {
      "type": "string",
      "description": "ZIP/postal code for card mailing address"
    },
    "orgId": {
      "type": "string",
      "description": "Organization this client belongs to"
    },
    "ownerId": {
      "type": "string",
      "description": "User who owns or manages this client"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the client"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the client"
    },
    "company": {
      "type": "string",
      "description": "Company name associated with the client"
    },
    "city": {
      "type": "string",
      "description": "City for card mailing address"
    },
    "state": {
      "type": "string",
      "description": "State/province for card mailing address"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organizing and filtering clients"
    },
    "source": {
      "type": "string",
      "description": "Where this client came from"
    },
    "lastNoteSentDate": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent date a note was sent to this client"
    },
    "totalNotesSent": {
      "type": "number",
      "description": "Total number of notes sent to this client",
      "default": 0
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "Client's birthday (YYYY-MM-DD) for birthday automation"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Client's renewal date (YYYY-MM-DD) for renewal reminder automation"
    },
    "referral_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "completed"
      ],
      "description": "Status of referral request for referral automation",
      "default": "none"
    },
    "automation_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "opted_out"
      ],
      "description": "Whether automations are active for this client",
      "default": "active"
    },
    "last_automation_trigger": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last automation trigger for this client"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the client"
    },
    "custom_fields": {
      "type": "object",
      "description": "Custom fields for storing additional client data"
    }
  },
  "required": [],
  "rls": {
    "create": null,
    "read": {
      "data.orgId": "{{user.orgId}}"
    },
    "update": {
      "data.orgId": "{{user.orgId}}"
    },
    "delete": {
      "data.orgId": "{{user.orgId}}"
    }
  }
}
