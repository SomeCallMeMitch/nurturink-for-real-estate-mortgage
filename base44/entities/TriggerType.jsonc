{
  "name": "TriggerType",
  "type": "object",
  "description": "Types of events that can trigger automated card sends",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the trigger type (e.g., 'Birthday')"
    },
    "key": {
      "type": "string",
      "description": "Unique identifier for the trigger type (e.g., 'birthday')"
    },
    "description": {
      "type": "string",
      "description": "Description of when this trigger fires"
    },
    "icon": {
      "type": "string",
      "description": "Icon name for UI display (e.g., 'cake' for birthday)"
    },
    "isActive": {
      "type": "boolean",
      "description": "Whether this trigger type is available for use",
      "default": true
    },
    "defaultDaysBefore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "description": "Default number of days before trigger to send card",
      "default": 0
    },
    "defaultDaysAfter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "description": "Default number of days after trigger to send card",
      "default": 0
    },
    "defaultFrequencyCap": {
      "type": "string",
      "enum": [
        "once",
        "annually",
        "monthly",
        "per_event"
      ],
      "description": "Default frequency cap for this trigger type",
      "default": "annually"
    },
    "clientFieldRequired": {
      "type": "string",
      "description": "Which client field is required for this trigger (e.g., 'birthday', 'renewal_date')"
    },
    "sortOrder": {
      "type": "integer",
      "description": "Display order in UI",
      "default": 0
    }
  },
  "required": []
}