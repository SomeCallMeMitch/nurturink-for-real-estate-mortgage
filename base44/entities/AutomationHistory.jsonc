{
  "name": "AutomationHistory",
  "type": "object",
  "description": "Tracks all automated cards sent through the automation system",
  "properties": {
    "automationRuleId": {
      "type": "string",
      "description": "Reference to the AutomationRule that triggered this send"
    },
    "clientId": {
      "type": "string",
      "description": "Reference to the Client who received the card"
    },
    "triggerType": {
      "type": "string",
      "enum": [
        "birthday",
        "new_client_welcome",
        "renewal_reminder",
        "referral_request"
      ],
      "description": "Type of trigger that caused this card to be sent"
    },
    "templateId": {
      "type": "string",
      "description": "Reference to the Template used for this card"
    },
    "sentDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the card was sent"
    },
    "scribeBatchId": {
      "type": "string",
      "description": "Batch ID returned by Scribe API for tracking fulfillment"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "pending",
        "cancelled"
      ],
      "description": "Current status of the automated card send",
      "default": "pending"
    },
    "errorMessage": {
      "type": "string",
      "description": "Error message if status is 'failed'"
    },
    "recipientName": {
      "type": "string",
      "description": "Name of the card recipient"
    },
    "recipientEmail": {
      "type": "string",
      "description": "Email of the card recipient"
    },
    "cardDesign": {
      "type": "string",
      "description": "Card design used (e.g., 'Thank you - Plain White')"
    },
    "noteStyle": {
      "type": "string",
      "description": "Note style profile used (e.g., 'casual')"
    },
    "messageContent": {
      "type": "string",
      "description": "Rendered message content sent on the card"
    }
  },
  "required": []
}