{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the white label partner"
    },
    "organizationId": {
      "type": "string",
      "description": "ID of the Organization record for this WL partner (accountType = 'whitelabel_partner')"
    },
    "partnerName": {
      "type": "string",
      "description": "White label partner display name"
    },
    "wholesalePricePerCredit": {
      "type": "number",
      "description": "Price in cents that WL partner pays to Super Admin for bulk credits"
    },
    "resalePricePerCredit": {
      "type": "number",
      "description": "Minimum price in cents that WL partner charges their clients (must be >= wholesalePricePerCredit)"
    },
    "customPricingTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pricingTierId": {
            "type": "string"
          },
          "customPriceCents": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Custom pricing tier overrides for this WL partner's clients"
    },
    "commissionPercentage": {
      "type": "number",
      "nullable": true,
      "description": "Optional commission percentage on each client purchase (0-100)"
    },
    "customDomain": {
      "type": "string",
      "nullable": true,
      "description": "Custom domain for white label branding (e.g., 'cards.partnername.com')"
    },
    "customBrandingLogoUrl": {
      "type": "string",
      "nullable": true,
      "description": "URL to custom logo for WL partner's branded instance"
    },
    "customBrandingFaviconUrl": {
      "type": "string",
      "nullable": true,
      "description": "URL to custom favicon for WL partner's branded instance"
    },
    "customBrandingPrimaryColor": {
      "type": "string",
      "nullable": true,
      "description": "Primary brand color (HEX format)"
    },
    "customBrandingAccentColor": {
      "type": "string",
      "nullable": true,
      "description": "Accent brand color (HEX format)"
    },
    "smsNotificationsEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether SMS alerts are enabled for this WL partner"
    },
    "smsPhoneNumber": {
      "type": "string",
      "nullable": true,
      "description": "Phone number to receive SMS alerts (E.164 format)"
    },
    "emailAlertsRecipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Email addresses to receive critical alerts (in addition to primary contact)"
    },
    "dailyDigestEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether to send daily digest report to WL partner"
    },
    "totalRevenueGenerated": {
      "type": "number",
      "default": 0,
      "description": "Total revenue generated by this WL partner (sum of all client purchases at resale price)"
    },
    "totalCostOfCredits": {
      "type": "number",
      "default": 0,
      "description": "Total cost paid to Super Admin for bulk credits (at wholesale price)"
    },
    "totalMargin": {
      "type": "number",
      "default": 0,
      "description": "Total margin earned (totalRevenueGenerated - totalCostOfCredits)"
    },
    "totalClientsManaged": {
      "type": "number",
      "default": 0,
      "description": "Number of companies/individuals under this WL partner"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Whether this WL partner account is active"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this WL partner was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this WL partner was last updated"
    }
  },
  "required": [
    "organizationId",
    "partnerName",
    "wholesalePricePerCredit",
    "resalePricePerCredit"
  ],
  "name": "WhitelabelPartner"
}