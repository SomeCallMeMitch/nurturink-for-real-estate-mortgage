{
  "name": "MailingBatch",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User who created this batch"
    },
    "organizationId": {
      "type": "string",
      "description": "Organization this batch belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_to_send",
        "pending_review",
        "sending",
        "completed",
        "partial",
        "pending_credits",
        "failed"
      ],
      "default": "draft",
      "description": "Current status of the batch workflow. 'pending_review' = awaiting admin approval (REQUIRE_ADMIN_APPROVAL=true). 'pending_credits' = Scribe returned 402."
    },
    "draftCurrentStep": {
      "type": "string",
      "enum": [
        "find_clients",
        "create_content",
        "select_design",
        "review_send"
      ],
      "nullable": true,
      "description": "Current wizard step for resumable draft batches"
    },
    "draftSavedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Last time the draft was explicitly or automatically saved"
    },
    "draftSavedExplicitlyAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Timestamp set only when the user explicitly clicks Save Draft"
    },
    "selectedClientIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of Client IDs for this batch"
    },
    "quickSendTemplateId": {
      "type": "string",
      "nullable": true,
      "description": "FK to QuickSendTemplate - tracks which template was used for analytics"
    },
    "globalMessage": {
      "type": "string",
      "nullable": true,
      "description": "The default message that applies to all recipients"
    },
    "contentOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client message overrides. Key = clientId, Value = custom message"
    },
    "selectedCardDesignId": {
      "type": "string",
      "nullable": true,
      "description": "Card design ID selected for all recipients (bulk mode)"
    },
    "cardDesignOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client card design overrides. Key = clientId, Value = card design ID"
    },
    "selectedNoteStyleProfileId": {
      "type": "string",
      "nullable": true,
      "description": "Note style profile ID selected for this batch"
    },
    "noteStyleProfileOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client note style profile overrides. Key = clientId, Value = note style profile ID"
    },
    "includeGreeting": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include greeting in the message"
    },
    "greetingOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client greeting inclusion overrides. Key = clientId, Value = boolean"
    },
    "includeSignature": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include signature in the message"
    },
    "signatureOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client signature inclusion overrides. Key = clientId, Value = boolean"
    },
    "returnAddressModeGlobal": {
      "type": "string",
      "enum": [
        "company",
        "rep",
        "none"
      ],
      "default": "company",
      "description": "Global return address preference for all recipients"
    },
    "returnAddressModeOverrides": {
      "type": "object",
      "nullable": true,
      "description": "Per-client return address overrides. Key = clientId, Value = 'company' | 'rep' | 'none'"
    },
    "scheduledSendId": {
      "type": "string",
      "nullable": true,
      "description": "FK to ScheduledSend that triggered this batch (null for manual sends). Used by processPendingSends pipeline."
    },
    "scribeCampaignId": {
      "type": "string",
      "nullable": true,
      "description": "ID of the campaign in the Scribe Nurture system (legacy - use scribeCampaigns array)"
    },
    "printPackageZipFileUri": {
      "type": "string",
      "nullable": true,
      "description": "URI of the print package ZIP file in Base44 private storage"
    },
    "scribeStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "processing",
        "printing",
        "printed",
        "shipped",
        "delivered",
        "paused",
        "on-going",
        "delete",
        "cancelled",
        "expect-48-hour-delay",
        "queued",
        "payment-pending"
      ],
      "default": "draft",
      "description": "Current status of the campaign in the Scribe Nurture system"
    },
    "scribeCampaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scribeCampaignId": {
            "type": "string",
            "description": "Campaign ID from Scribe API"
          },
          "campaignGroupKey": {
            "type": "string",
            "description": "Hash identifying this message+design+returnAddress combination"
          },
          "cardDesignId": {
            "type": "string",
            "description": "Card design used for this campaign"
          },
          "returnAddressMode": {
            "type": "string",
            "enum": [
              "company",
              "rep",
              "none"
            ]
          },
          "clientIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Client IDs included in this campaign"
          },
          "contactCount": {
            "type": "number",
            "description": "Number of contacts submitted to Scribe"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "submitted",
              "needs_credits",
              "failed"
            ],
            "description": "Status of this specific campaign submission"
          },
          "scribeStatus": {
            "type": "string",
            "nullable": true,
            "description": "Latest status from Scribe API"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true,
            "description": "Error message if campaign creation failed"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "default": [],
      "description": "Array of Scribe campaigns created for this batch. One per unique message+design+returnAddress combination."
    },
    "processedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the batch was processed/sent to Scribe"
    },
    "totalCreditsUsed": {
      "type": "number",
      "default": 0,
      "description": "Total credits deducted for this batch"
    },
    "processingErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Errors encountered during processing (per-client errors)"
    }
  },
  "required": [
    "userId",
    "organizationId",
    "selectedClientIds"
  ]
}